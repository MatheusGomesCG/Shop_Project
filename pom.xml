<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>
  <groupId>app.foodcenture</groupId>
  <artifactId>foodcenture-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FoodCenture</name>

  <modules>
    <module>services/auth</module>
    <module>services/catalog</module>
    <module>services/order</module>
    <module>services/payment</module>
    <module>services/delivery</module>
    <module>services/admin-bff</module>
    <module>coverage-report</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2023.0.6</spring-cloud.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <archunit.version>1.4.2</archunit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <jjwt.version>0.12.6</jjwt.version>
    <json-schema-validator.version>1.5.9</json-schema-validator.version>
    <coverage.instruction.minimum>0.90</coverage.instruction.minimum>
    <coverage.line.minimum>0.90</coverage.line.minimum>
    <coverage.branch.minimum>0.85</coverage.branch.minimum>
    <coverage.class.line.minimum>0.80</coverage.class.line.minimum>
    <argLine/>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <classifier>exec</classifier>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>supported-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,22)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9.6,4)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>shared-infrastructure-tests</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources><source>${maven.multiModuleProjectDirectory}/infra/tests/java</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <argLine>@{argLine}</argLine>
          <systemPropertyVariables>
            <foodcenture.root>${maven.multiModuleProjectDirectory}</foodcenture.root>
            <foodcenture.package>${service.package}</foodcenture.package>
            <foodcenture.classes>${project.build.outputDirectory}</foodcenture.classes>
            <!-- Testes com Testcontainers usam as mesmas migrations do Flyway de produção. -->
            <spring.flyway.locations>filesystem:${maven.multiModuleProjectDirectory}/infra/migrations</spring.flyway.locations>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>require-coverage-data</id>
            <phase>verify</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <fail message="Sem dados de cobertura. Execute os testes do serviço antes de verify.">
                  <condition>
                    <and>
                      <not><equals arg1="${project.packaging}" arg2="pom"/></not>
                      <not><available file="${project.build.directory}/jacoco.exec"/></not>
                    </and>
                  </condition>
                </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <exclude>**/*Application.class</exclude>
            <exclude>**/config/**</exclude>
            <exclude>**/dto/**</exclude>
            <exclude>**/entity/**</exclude>
            <exclude>**/*MapperImpl.class</exclude>
            <exclude>**/generated/**</exclude>
          </excludes>
          <rules>
            <rule>
              <element>BUNDLE</element>
              <limits>
                <limit><counter>INSTRUCTION</counter><value>COVEREDRATIO</value><minimum>${coverage.instruction.minimum}</minimum></limit>
                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${coverage.line.minimum}</minimum></limit>
                <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${coverage.branch.minimum}</minimum></limit>
                <limit><counter>CLASS</counter><value>MISSEDCOUNT</value><maximum>0</maximum></limit>
                <limit><counter>INSTRUCTION</counter><value>TOTALCOUNT</value><minimum>1</minimum></limit>
              </limits>
            </rule>
            <rule>
              <element>CLASS</element>
              <includes>
                <include>*.domain.*</include>
                <include>*.service.*</include>
              </includes>
              <limits>
                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${coverage.class.line.minimum}</minimum></limit>
              </limits>
            </rule>
          </rules>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
